# RepoMedic Environment Configuration
# Copy this file to .env and configure your keys. Never commit your .env file!

# Nebius Token Factory API Key
NEBIUS_API_KEY=

# Nebius Token Factory Base URL (OpenAI-compatible)
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model identifier (e.g., nvidia/Nemotron-3_5-Lightning or custom model ID)
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
